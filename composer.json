{
    "name": "protung/open-api-generator",
    "description": "Generate OpenAPI specifications from Symfony routes, forms, mapped request payloads, validation constraints and JMS Serializer metadata.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "openapi",
        "open api",
        "openapi generator",
        "open api schema generator",
        "swagger",
        "swagger schema generator",
        "schema",
        "specification",
        "symfony",
        "jms serializer"
    ],
    "authors": [
        {
            "name": "Dragos Protung",
            "email": "dragos@protung.de"
        },
        {
            "name": "Cezary Stepkowski",
            "email": "cezary.stepkowski@protonmail.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "devizzent/cebe-php-openapi": "^1.1.5",
        "myclabs/deep-copy": "^1.10",
        "php-standard-library/php-standard-library": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.0.0",
        "phpstan/phpdoc-parser": "^2.0.0",
        "symfony/form": "^6.4 || ^7.4 || ^8.0",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/validator": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.50.0",
        "doctrine/coding-standard": "^14.0.0",
        "ergebnis/composer-normalize": "^2.54.0",
        "jms/metadata": "^2.8.0",
        "jms/serializer": "^3.30.0",
        "php-standard-library/phpstan-extension": "^2.1.0",
        "phpstan/phpstan": "^2.2.15",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^11.5.56",
        "roave/security-advisories": "dev-master",
        "symfony/config": "^6.4 || ^7.4 || ^8.0.8",
        "symfony/options-resolver": "^6.4 || ^7.4 || ^8.0.8",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0.8",
        "symfony/yaml": "^6.4 || ^7.4.1 || ^8.0.8"
    },
    "conflict": {
        "jms/metadata": "<2.8.0",
        "jms/serializer": "<3.30.0"
    },
    "suggest": {
        "jms/serializer": "To describe objects from their JMS Serializer metadata, and serialize example objects"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Protung\\OpenApiGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Protung\\OpenApiGenerator\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    }
}
